@{
    ViewData["Title"] = "О магазине";
}

<div style="max-width: 800px; margin: 3rem auto;">
    <h1 style="margin-bottom: 2rem; color: #1e293b;">О Stationery Store</h1>

    <div style="background: white; padding: 2rem; border-radius: 12px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1); margin-bottom: 2rem;">
        <h2 style="color: #2563eb; margin-bottom: 1rem;">Кто мы?</h2>
        <p style="margin-bottom: 1rem; line-height: 1.8;">
            Stationery Store — это современный интернет-магазин канцелярских товаров, который предлагает широкий ассортимент качественной продукции для работы, учёбы и творчества.
        </p>
        <p style="margin-bottom: 1rem; line-height: 1.8;">
            Мы стремимся предоставить нашим клиентам лучшие товары по доступным ценам с быстрой доставкой и отличным обслуживанием.
        </p>
    </div>

    <div style="background: white; padding: 2rem; border-radius: 12px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1); margin-bottom: 2rem;">
        <h2 style="color: #2563eb; margin-bottom: 1rem;">Наши ценности</h2>
        <ul style="margin-left: 1.5rem; line-height: 1.8;">
            <li><strong>Качество:</strong> Мы работаем только с надежными производителями</li>
            <li><strong>Доступность:</strong> Справедливые цены для всех клиентов</li>
            <li><strong>Надежность:</strong> Быстрая доставка и гарантированное качество</li>
            <li><strong>Сервис:</strong> Всегда готовы помочь нашим клиентам</li>
        </ul>
    </div>

    <div style="background: white; padding: 2rem; border-radius: 12px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);">
        <h2 style="color: #2563eb; margin-bottom: 1rem;">Почему выбирают нас?</h2>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;">
            <div>
                <h3 style="color: #1e293b; margin-bottom: 0.5rem;">✓ Широкий ассортимент</h3>
                <p>Более 200 наименований товаров</p>
            </div>
            <div>
                <h3 style="color: #1e293b; margin-bottom: 0.5rem;">✓ Конкурентные цены</h3>
                <p>Лучшие предложения на рынке</p>
            </div>
            <div>
                <h3 style="color: #1e293b; margin-bottom: 0.5rem;">✓ Быстрая доставка</h3>
                <p>Доставка по всей России</p>
            </div>
            <div>
                <h3 style="color: #1e293b; margin-bottom: 0.5rem;">✓ Поддержка 24/7</h3>
                <p>Всегда готовы помочь</p>
            </div>
        </div>
    </div>

    <div style="text-align: center; margin-top: 3rem;">
        <a href="/Product/Catalog" class="btn btn-primary" style="padding: 1rem 2rem; font-size: 1.1rem;">
            Перейти в каталог
        </a>
    </div>
</div>
