@using cursovaia2.Models
@model CheckoutViewModel
@{
    ViewData["Title"] = "Оформление заказа";
    var customer = ViewBag.Customer as cursovaia2.ModelsDb.CustomerDb;
    var firstDelivery = Model.DeliveryMethods.FirstOrDefault();
}

<div class="checkout-page">
    <h1>Оформление заказа</h1>

    @if (!Model.DeliveryMethods.Any() || !Model.PaymentMethods.Any())
    {
        <div class="alert alert-danger">
            Справочники доставки или оплаты пусты. Перезапустите приложение или откройте
            <a href="/Test/AddTestData">/Test/AddTestData</a> для заполнения данных.
        </div>
    }

    <div class="checkout-layout">
        <section class="checkout-form-panel">
            <form id="checkoutForm" onsubmit="return false;">
                <h3>Адрес доставки</h3>
                <div class="form-group">
                    <label for="city">Город *</label>
                    <input type="text" id="city" required placeholder="Москва" value="">
                </div>
                <div class="form-group">
                    <label for="address">Адрес *</label>
                    <input type="text" id="address" required placeholder="Улица, дом, квартира" value="">
                </div>
                <div class="form-group">
                    <label for="postalCode">Индекс</label>
                    <input type="text" id="postalCode" placeholder="123456" value="">
                </div>
                <div class="form-group">
                    <label for="phone">Телефон *</label>
                    <input type="tel" id="phone" required placeholder="+7 (999) 123-45-67"
                           value="@(customer?.Phone ?? "")">
                </div>

                <h3>Способ доставки *</h3>
                @if (Model.DeliveryMethods.Any())
                {
                    <div class="checkout-options">
                        @foreach (var dm in Model.DeliveryMethods)
                        {
                            <label class="checkout-option">
                                <input type="radio" name="delivery" value="@dm.Id"
                                       data-price="@dm.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                       @(dm == firstDelivery ? "checked" : "")>
                                <span class="checkout-option__body">
                                    <strong>@dm.Name</strong>
                                    <span class="checkout-option__price">
                                        @(dm.Price > 0 ? dm.Price.ToString("N0") + " ₽" : "Бесплатно")
                                    </span>
                                </span>
                            </label>
                        }
                    </div>
                }
                else
                {
                    <p class="text-danger">Нет доступных способов доставки.</p>
                }

                <h3>Способ оплаты *</h3>
                @if (Model.PaymentMethods.Any())
                {
                    <div class="checkout-options">
                        @foreach (var pm in Model.PaymentMethods)
                        {
                            <label class="checkout-option">
                                <input type="radio" name="payment" value="@pm.Id"
                                       @(pm == Model.PaymentMethods.First() ? "checked" : "")>
                                <span class="checkout-option__body">
                                    <strong>@pm.Name</strong>
                                </span>
                            </label>
                        }
                    </div>
                }
                else
                {
                    <p class="text-danger">Нет доступных способов оплаты.</p>
                }

                <h3>Промокод</h3>
                <div class="promo-row">
                    <input type="text" id="promoCode" placeholder="Введите промокод">
                    <button type="button" class="btn btn-secondary" onclick="applyPromo()">Применить</button>
                </div>
                <p id="promoMessage" class="promo-message"></p>

                <button type="button" id="submitOrderBtn" class="btn btn-primary btn-lg btn-block"
                        onclick="submitOrder()" @(Model.DeliveryMethods.Any() && Model.PaymentMethods.Any() ? "" : "disabled")>
                    Подтвердить заказ
                </button>
                <p id="checkoutError" class="promo-message promo-message--err" style="display:none;"></p>
            </form>
        </section>

        <aside class="checkout-summary">
            <h3>Ваш заказ</h3>
            @foreach (var item in Model.Cart.Items)
            {
                <div class="checkout-item">
                    <span>@item.ProductName × @item.Quantity</span>
                    <strong>@((item.Price * item.Quantity).ToString("N0")) ₽</strong>
                </div>
            }
            <hr>
            <div class="summary-row"><span>Товары:</span><span id="subtotalDisplay">@Model.Subtotal.ToString("N0") ₽</span></div>
            <div class="summary-row"><span>Доставка:</span><span id="deliveryDisplay">—</span></div>
            <div class="summary-row"><span>Скидка по промокоду:</span><span id="discountDisplay">0 ₽</span></div>
            <div class="summary-row summary-row--total"><span>Итого к оплате:</span><span id="totalDisplay">@Model.Subtotal.ToString("N0") ₽</span></div>
        </aside>
    </div>
</div>

<script>
    const subtotal = @Model.Subtotal.ToString(System.Globalization.CultureInfo.InvariantCulture);
    let deliveryPrice = @(firstDelivery?.Price.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0");
    let promoDiscount = 0;

    document.querySelectorAll('input[name="delivery"]').forEach(r => {
        r.addEventListener('change', () => {
            deliveryPrice = parseFloat(r.dataset.price) || 0;
            updateTotals();
        });
    });
    updateTotals();

    function updateTotals() {
        const delEl = document.getElementById('deliveryDisplay');
        if (delEl) delEl.textContent = deliveryPrice > 0 ? deliveryPrice.toLocaleString('ru-RU') + ' ₽' : 'Бесплатно';
        document.getElementById('discountDisplay').textContent = promoDiscount > 0 ? '−' + promoDiscount.toLocaleString('ru-RU') + ' ₽' : '0 ₽';
        const total = Math.max(0, subtotal + deliveryPrice - promoDiscount);
        document.getElementById('totalDisplay').textContent = total.toLocaleString('ru-RU') + ' ₽';
    }

    function showCheckoutError(msg) {
        const el = document.getElementById('checkoutError');
        el.textContent = msg;
        el.style.display = 'block';
    }

    function applyPromo() {
        const code = document.getElementById('promoCode').value.trim();
        if (!code) return;
        fetch('/Checkout/ApplyPromo', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ promoCode: code, subtotal: subtotal + deliveryPrice })
        })
        .then(r => r.json())
        .then(data => {
            const msg = document.getElementById('promoMessage');
            if (data.success) {
                promoDiscount = data.discountAmount;
                msg.textContent = data.message;
                msg.className = 'promo-message promo-message--ok';
            } else {
                promoDiscount = 0;
                msg.textContent = data.message || 'Промокод не действует';
                msg.className = 'promo-message promo-message--err';
            }
            updateTotals();
        })
        .catch(() => showCheckoutError('Не удалось проверить промокод'));
    }

    function submitOrder() {
        document.getElementById('checkoutError').style.display = 'none';

        const deliveryRadio = document.querySelector('input[name="delivery"]:checked');
        const paymentRadio = document.querySelector('input[name="payment"]:checked');

        if (!deliveryRadio) { showCheckoutError('Выберите способ доставки'); return; }
        if (!paymentRadio) { showCheckoutError('Выберите способ оплаты'); return; }

        const address = document.getElementById('address').value.trim();
        const city = document.getElementById('city').value.trim();
        const phone = document.getElementById('phone').value.trim();

        if (!city || !address || !phone) {
            showCheckoutError('Заполните город, адрес и телефон');
            return;
        }

        const btn = document.getElementById('submitOrderBtn');
        btn.disabled = true;
        btn.textContent = 'Оформляем...';

        const data = {
            address: address,
            city: city,
            postalCode: document.getElementById('postalCode').value.trim(),
            phone: phone,
            promoCode: document.getElementById('promoCode').value.trim(),
            deliveryMethodId: parseInt(deliveryRadio.value, 10),
            paymentMethodId: parseInt(paymentRadio.value, 10)
        };

        fetch('/Checkout/PlaceOrder', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        })
        .then(async r => {
            const text = await r.text();
            try { return JSON.parse(text); }
            catch { throw new Error(text || 'Ошибка сервера'); }
        })
        .then(data => {
            if (data.success) {
                window.location.href = `/Checkout/OrderConfirmed?orderId=${data.orderId}`;
            } else {
                showCheckoutError(data.message || 'Ошибка оформления');
                btn.disabled = false;
                btn.textContent = 'Подтвердить заказ';
            }
        })
        .catch(err => {
            showCheckoutError(err.message || 'Сетевая ошибка при оформлении');
            btn.disabled = false;
            btn.textContent = 'Подтвердить заказ';
        });
    }
</script>
