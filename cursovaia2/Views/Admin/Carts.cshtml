@model List<cursovaia2.ModelsDb.CartDb>
@{ ViewData["Title"] = "Корзины"; }
<div class="admin-panel">
    <table class="admin-table">
        <thead><tr><th>ID</th><th>Покупатель</th><th>Позиций</th><th>Обновлена</th></tr></thead>
        <tbody>@foreach (var c in Model) {
            <tr>
                <td>@c.Id</td>
                <td>@(c.Customer?.Name ?? $"Customer #{c.CustomerId}")</td>
                <td>@c.Items.Sum(i => i.Quantity)</td>
                <td>@((c.UpdatedAt ?? c.CreatedAt).ToLocalTime().ToString("g"))</td>
            </tr>
        }</tbody>
    </table>
</div>
