@model List<cursovaia2.ModelsDb.BrandDb>
@{ ViewData["Title"] = "Бренды"; }

<div class="admin-panel">
    <form method="post" action="/Admin/SaveBrand" class="admin-form">
        @Html.AntiForgeryToken()
        <div><label>Название бренда</label><input type="text" name="name" required></div>
        <button type="submit" class="btn btn-primary">Добавить</button>
    </form>
</div>
<div class="admin-panel">
    <table class="admin-table">
        <thead><tr><th>ID</th><th>Название</th><th></th></tr></thead>
        <tbody>
        @foreach (var b in Model)
        {
            <tr>
                <td>@b.Id</td>
                <td>
                    <form method="post" action="/Admin/SaveBrand" class="admin-form" style="grid-template-columns:1fr auto;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@b.Id">
                        <input type="text" name="name" value="@b.Name" required>
                        <button type="submit" class="btn-admin btn-admin--primary">Сохранить</button>
                    </form>
                </td>
                <td>
                    <form method="post" action="/Admin/DeleteBrand" onsubmit="return confirm('Удалить?')">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@b.Id">
                        <button type="submit" class="btn-admin btn-admin--danger">×</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
