@using cursovaia2.Models;
@model Cart

@{
	ViewData["Title"] = "Оформление заказа";
	var customerId = ViewBag.CustomerId;
	var customer = ViewBag.Customer;
}

<div class="container mt-4">
	<div class="row">
		<div class="col-md-8">
			<h1>📦 Оформление заказа</h1>
			<hr>

			<!-- Форма доставки -->
			<div class="card mb-4">
				<div class="card-header bg-primary text-white">
					<h5 class="mb-0">📍 Адрес доставки</h5>
				</div>
				<div class="card-body">
					<form id="checkoutForm">
						<div class="mb-3">
							<label for="address" class="form-label">Адрес:</label>
							<input type="text" class="form-control" id="address" name="address" placeholder="Улица, дом, квартира" required>
						</div>

						<div class="row">
							<div class="col-md-6">
								<div class="mb-3">
									<label for="city" class="form-label">Город:</label>
									<input type="text" class="form-control" id="city" name="city" placeholder="Москва" required>
								</div>
							</div>
							<div class="col-md-6">
								<div class="mb-3">
									<label for="postalCode" class="form-label">Почтовый индекс:</label>
									<input type="text" class="form-control" id="postalCode" name="postalCode" placeholder="119991" required>
								</div>
							</div>
						</div>

						<div class="mb-3">
							<label for="phone" class="form-label">Телефон:</label>
							<input type="tel" class="form-control" id="phone" name="phone" placeholder="+7 (999) 123-45-67" required>
						</div>

						<!-- Способ доставки -->
						<div class="mb-4">
							<label class="form-label">Способ доставки:</label>
							<div class="form-check">
								<input class="form-check-input" type="radio" name="delivery" id="delivery1" value="1" checked>
								<label class="form-check-label" for="delivery1">
									Стандартная доставка (5-7 дней) - 300 ₽
								</label>
							</div>
							<div class="form-check">
								<input class="form-check-input" type="radio" name="delivery" id="delivery2" value="2">
								<label class="form-check-label" for="delivery2">
									Экспресс доставка (1-2 дня) - 800 ₽
								</label>
							</div>
							<div class="form-check">
								<input class="form-check-input" type="radio" name="delivery" id="delivery3" value="3">
								<label class="form-check-label" for="delivery3">
									Самовывоз - Бесплатно
								</label>
							</div>
						</div>

						<!-- Способ оплаты -->
						<div class="mb-4">
							<label class="form-label">Способ оплаты:</label>
							<div class="form-check">
								<input class="form-check-input" type="radio" name="payment" id="payment1" value="1" checked>
								<label class="form-check-label" for="payment1">
									Карта (при доставке)
								</label>
							</div>
							<div class="form-check">
								<input class="form-check-input" type="radio" name="payment" id="payment2" value="2">
								<label class="form-check-label" for="payment2">
									Наличные (при доставке)
								</label>
							</div>
							<div class="form-check">
								<input class="form-check-input" type="radio" name="payment" id="payment3" value="3">
								<label class="form-check-label" for="payment3">
									Онлайн-платёж
								</label>
							</div>
						</div>

						<button type="button" class="btn btn-primary btn-lg w-100" onclick="submitOrder()">
							✓ Подтвердить заказ
						</button>
					</form>
				</div>
			</div>
		</div>

		<!-- Итоги заказа -->
		<div class="col-md-4">
			<div class="card sticky-top" style="top: 20px;">
				<div class="card-header bg-success text-white">
					<h5 class="mb-0">💰 Ваш заказ</h5>
				</div>
				<div class="card-body">
					@if (Model != null && Model.Items.Any())
					{
						<div class="mb-3" style="max-height: 300px; overflow-y: auto;">
							@foreach (var item in Model.Items.GroupBy(x => x.ProductId))
							{
								<div class="d-flex justify-content-between mb-2 pb-2 border-bottom">
									<div>
										<div class="fw-bold">@item.First().ProductName</div>
										<small class="text-muted">@item.Count() шт. × @item.First().Price.ToString("C")</small>
									</div>
									<div class="text-end fw-bold">@(item.First().Price * item.Count()).ToString("C")</div>
								</div>
							}
						</div>

						<hr>

						<div class="mb-2">
							<div class="d-flex justify-content-between">
								<span>Товары:</span>
								<strong>@Model.Total.ToString("C")</strong>
							</div>
						</div>

						<div class="mb-3">
							<div class="d-flex justify-content-between">
								<span>Доставка:</span>
								<strong id="deliveryPrice">300 ₽</strong>
							</div>
						</div>

						<hr>

						<div class="mb-3">
							<h5 class="d-flex justify-content-between">
								<span>ИТОГО:</span>
								<strong class="text-success" id="totalPrice">@(Model.Total + 300).ToString("C")</strong>
							</h5>
						</div>

						<div class="alert alert-info" role="alert">
							<small>
								<strong>📝 Заказов:</strong> @Model.ItemCount<br>
								<strong>📦 Товаров:</strong> @Model.Items.Count() шт.
							</small>
						</div>
					}
				</div>
			</div>
		</div>
	</div>
</div>

<script>
	const basePrice = @Model.Total;

	document.querySelectorAll('input[name="delivery"]').forEach(radio => {
		radio.addEventListener('change', updateTotal);
	});

	function updateTotal() {
		const deliverySelected = document.querySelector('input[name="delivery"]:checked').value;
		let deliveryPrice = 0;
		let deliveryText = '';

		if (deliverySelected == '1') {
			deliveryPrice = 300;
			deliveryText = '300 ₽';
		} else if (deliverySelected == '2') {
			deliveryPrice = 800;
			deliveryText = '800 ₽';
		} else {
			deliveryPrice = 0;
			deliveryText = 'Бесплатно';
		}

		document.getElementById('deliveryPrice').textContent = deliveryText;
		const total = basePrice + deliveryPrice;
		document.getElementById('totalPrice').textContent = total.toLocaleString('ru-RU', { style: 'currency', currency: 'RUB' });
	}

	function submitOrder() {
		const form = document.getElementById('checkoutForm');
		const formData = new FormData(form);

		// Преобразуем данные формы в JSON
		const data = {
			address: document.getElementById('address').value,
			city: document.getElementById('city').value,
			postalCode: document.getElementById('postalCode').value,
			phone: document.getElementById('phone').value
		};

		fetch('/Checkout/PlaceOrder', {
			method: 'POST',
			headers: {
				'Content-Type': 'application/json',
			},
			body: JSON.stringify(data)
		})
		.then(response => response.json())
		.then(data => {
			if (data.success) {
				window.location.href = `/Checkout/OrderConfirmed?orderId=${data.orderId}`;
			} else {
				alert('❌ Ошибка: ' + data.message);
			}
		})
		.catch(error => {
			console.error('Error:', error);
			alert('❌ Ошибка при оформлении заказа');
		});
	}
</script>
