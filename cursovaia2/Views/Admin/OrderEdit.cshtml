@model cursovaia2.ModelsDb.OrderDb
@using cursovaia2.ModelsDb
@{ ViewData["Title"] = $"Заказ #{Model.Id}"; var history = ViewBag.History as List<OrderStatusHistoryDb> ?? new(); }

<div class="admin-panel">
    <p><strong>Покупатель:</strong> @(Model.Customer?.Name) | <strong>Создан:</strong> @Model.CreatedAt.ToLocalTime().ToString("g")</p>
    <form method="post" action="/Admin/SaveOrder" class="admin-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id">
        <div><label>Скидка</label><select name="discountId" asp-items="ViewBag.Discounts"><option value="">—</option></select></div>
        <div><label>Промокод</label><select name="promoCodeId" asp-items="ViewBag.PromoCodes"><option value="">—</option></select></div>
        <div><label>Итого</label><input type="number" step="0.01" name="finalPrice" value="@Model.FinalPrice"></div>
        <button type="submit" class="btn btn-primary">Сохранить</button>
    </form>
</div>

<div class="admin-panel">
    <h3>Сменить статус</h3>
    <form method="post" action="/Admin/UpdateOrderStatus" class="admin-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id">
        <div><label>Статус</label><select name="status" asp-items="ViewBag.Statuses"></select></div>
        <div><label>Комментарий</label><input type="text" name="comment"></div>
        <button type="submit" class="btn-admin btn-admin--primary">Обновить статус</button>
    </form>
</div>

<div class="admin-panel">
    <h3>Товары в заказе</h3>
    <table class="admin-table">
        <thead><tr><th>Товар</th><th>Кол-во</th><th>Цена</th></tr></thead>
        <tbody>@foreach (var i in Model.Items) { <tr><td>@(i.Product?.Name)</td><td>@i.Quantity</td><td>@i.Price</td></tr> }</tbody>
    </table>
</div>

@if (Model.Payments.Any())
{
    <div class="admin-panel"><h3>Платежи</h3><ul>@foreach (var p in Model.Payments) { <li>@p.Amount ₽ — @p.Status (@(p.Method?.Name))</li> }</ul></div>
}
@if (Model.Deliveries.Any())
{
    <div class="admin-panel"><h3>Доставки</h3><ul>@foreach (var d in Model.Deliveries) { <li>@d.Address — @d.Status</li> }</ul></div>
}

<div class="admin-panel">
    <h3>История статусов</h3>
  @if (history.Any()) {
    <table class="admin-table"><thead><tr><th>Было</th><th>Стало</th><th>Когда</th><th>Комментарий</th></tr></thead>
    <tbody>@foreach (var h in history) { <tr><td>@(h.OldStatus ?? "—")</td><td>@h.NewStatus</td><td>@h.ChangedAt.ToLocalTime().ToString("g")</td><td>@h.Comment</td></tr> }</tbody></table>
  } else { <p>История пуста</p> }
</div>
<p><a href="/Admin/Orders">← К заказам</a></p>
