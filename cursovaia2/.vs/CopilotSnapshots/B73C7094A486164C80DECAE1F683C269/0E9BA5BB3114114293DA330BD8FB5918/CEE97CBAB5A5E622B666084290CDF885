@using cursovaia2.ModelsDb;

@{
    ViewData["Title"] = "Каталог товаров";
}

<div class="container-fluid mt-5">
    <!-- Заголовок -->
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-4">🛍️ Каталог товаров</h1>
            <p class="text-muted lead">Найдите товары, которые вам нравятся</p>
        </div>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @ViewBag.Error
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <!-- Фильтры (левая панель) -->
        <div class="col-lg-3 col-md-4 mb-4">
            <!-- Поиск -->
            <div class="filter-section mb-4">
                <form method="get" action="/Product/Catalog" id="filterForm">
                    <div class="search-bar">
                        <input type="text" name="searchQuery" class="form-control" placeholder="🔍 Поиск товаров..." value="@(Model?.GetType().GetProperty("SearchQuery")?.GetValue(Model) as string)">
                        <button type="submit" class="btn btn-primary">Найти</button>
                    </div>
                </form>
            </div>

            <!-- Категории -->
            <div class="filter-section">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">📂 Категории</h5>
                    </div>
                    <div class="list-group list-group-flush">
                        <a href="/Product/Catalog" class="list-group-item list-group-item-action">
                            ✓ Все категории
                        </a>
                        @if (Model != null)
                        {
                            var categories = Model.GetType().GetProperty("Categories")?.GetValue(Model) as List<CategoryDb>;
                            var selectedCategoryId = Model.GetType().GetProperty("SelectedCategoryId")?.GetValue(Model) as int?;
                            if (categories != null && categories.Any())
                            {
                                @foreach (var category in categories)
                                {
                                    var isActive = selectedCategoryId == category.Id;
                                    <a href="/Product/Catalog?categoryId=@category.Id" 
                                       class="list-group-item list-group-item-action @(isActive ? "active" : "")">
                                        @category.Name
                                    </a>
                                }
                            }
                        }
                    </div>
                </div>
            </div>

            <!-- Бренды -->
            <div class="filter-section mt-4">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">🏢 Бренды</h5>
                    </div>
                    <div class="list-group list-group-flush">
                        <a href="/Product/Catalog" class="list-group-item list-group-item-action">
                            ✓ Все бренды
                        </a>
                        @if (Model != null)
                        {
                            var brands = Model.GetType().GetProperty("Brands")?.GetValue(Model) as List<BrandDb>;
                            var selectedBrandId = Model.GetType().GetProperty("SelectedBrandId")?.GetValue(Model) as int?;
                            if (brands != null && brands.Any())
                            {
                                @foreach (var brand in brands)
                                {
                                    var isActive = selectedBrandId == brand.Id;
                                    <a href="/Product/Catalog?brandId=@brand.Id" 
                                       class="list-group-item list-group-item-action @(isActive ? "active" : "")">
                                        @brand.Name
                                    </a>
                                }
                            }
                        }
                    </div>
                </div>
            </div>

            <!-- Цена -->
            <div class="filter-section mt-4">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">💰 Цена</h5>
                    </div>
                    <div class="card-body">
                        <form method="get" action="/Product/Catalog" id="priceForm">
                            <div class="mb-3">
                                <label class="form-label">От:</label>
                                <input type="number" name="minPrice" class="form-control" placeholder="Мин. цена" step="0.01">
                            </div>
                            <div class="mb-3">
                                <label class="form-label">До:</label>
                                <input type="number" name="maxPrice" class="form-control" placeholder="Макс. цена" step="0.01">
                            </div>
                            <button type="submit" class="btn btn-sm btn-primary w-100">Применить</button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Сортировка -->
            <div class="filter-section mt-4">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">⬆️ Сортировка</h5>
                    </div>
                    <div class="card-body">
                        <form method="get" action="/Product/Catalog" id="sortForm">
                            <select name="sortBy" class="form-select form-select-sm" onchange="this.form.submit()">
                                <option value="">По умолчанию</option>
                                <option value="name_asc">По названию (А-Я)</option>
                                <option value="name_desc">По названию (Я-А)</option>
                                <option value="price_asc">По цене (возрастание)</option>
                                <option value="price_desc">По цене (убывание)</option>
                            </select>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Товары (правая панель) -->
        <div class="col-lg-9 col-md-8">
            @if (Model != null)
            {
                var products = Model.GetType().GetProperty("Products")?.GetValue(Model) as List<ProductDb>;

                @if (products != null && products.Any())
                {
                    <div class="row">
                        @foreach (var product in products)
                        {
                            <div class="col-sm-6 col-lg-4 col-xl-3 mb-4">
                                <div class="card product-card">
                                    <!-- Изображение -->
                                    <div class="card-img-top" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                                        📦
                                    </div>

                                    <div class="card-body d-flex flex-column">
                                        <!-- Название -->
                                        <h5 class="card-title">@product.Name</h5>

                                        <!-- Описание -->
                                        <p class="card-text text-muted small">
                                            @(product.Description?.Length > 40 ? product.Description.Substring(0, 40) + "..." : product.Description)
                                        </p>

                                        <!-- Категория и Бренд -->
                                        <div class="mb-2">
                                            @if (product.Category != null)
                                            {
                                                <small class="text-muted d-block">📁 @product.Category.Name</small>
                                            }
                                            @if (product.Brand != null)
                                            {
                                                <small class="text-muted d-block">🏢 @product.Brand.Name</small>
                                            }
                                        </div>

                                        <!-- Цена и статус -->
                                        <div class="d-flex justify-content-between align-items-center mb-3 mt-auto">
                                            <span class="product-price">@product.Price.ToString("C")</span>
                                            <span class="product-badge">В наличии</span>
                                        </div>

                                        <!-- Кнопки -->
                                        <div class="d-grid gap-2">
                                            <a href="/Product/Detail/@product.Id" class="btn btn-outline-info btn-sm">
                                                👁️ Подробнее
                                            </a>
                                            <button class="btn btn-success btn-sm" onclick="addToCart(@product.Id, 1)">
                                                🛒 Добавить
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-info text-center">
                        <h5>😕 Товары не найдены</h5>
                        <p class="mb-0">Попробуйте изменить параметры фильтрации или поиска</p>
                    </div>
                }
            }
            else
            {
                <div class="alert alert-warning text-center">
                    <h5>⚠️ Ошибка при загрузке каталога</h5>
                    <p class="mb-0">Пожалуйста, обновите страницу</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- JavaScript для корзины и интерактивности -->
<script>
    // Добавление товара в корзину
    function addToCart(productId, quantity) {
        fetch('/Cart/AddToCart', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                productId: productId,
                quantity: quantity
            })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                showNotification('✓ ' + data.message, 'success');
                updateCartCount(data.cartCount);
            } else {
                showNotification('❌ ' + data.message, 'danger');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            showNotification('❌ Ошибка при добавлении в корзину', 'danger');
        });
    }

    // Показ уведомления
    function showNotification(message, type) {
        const existing = document.querySelector('.toast-notification');
        if (existing) {
            existing.remove();
        }

        const toast = document.createElement('div');
        toast.className = `toast-notification alert alert-${type}`;
        toast.textContent = message;
        toast.style.cssText = `
            position: fixed;
            top: 20px;
            right: 20px;
            min-width: 300px;
            z-index: 9999;
            animation: slideIn 0.3s ease;
        `;

        document.body.appendChild(toast);

        setTimeout(() => {
            toast.style.animation = 'slideOut 0.3s ease';
            setTimeout(() => toast.remove(), 300);
        }, 3000);
    }

    // Обновление счётчика корзины
    function updateCartCount(count) {
        const cartCount = document.querySelector('[data-cart-count]');
        if (cartCount) {
            cartCount.textContent = count;
        }
    }

    // Загрузка начального счётчика
    document.addEventListener('DOMContentLoaded', function() {
        fetch('/Cart/GetCartCount')
            .then(response => response.json())
            .then(data => {
                updateCartCount(data.count);
            })
            .catch(error => console.error('Error fetching cart count:', error));
    });

    // Стили анимации
    const style = document.createElement('style');
    style.textContent = `
        @keyframes slideIn {
            from {
                transform: translateX(400px);
                opacity: 0;
            }
            to {
                transform: translateX(0);
                opacity: 1;
            }
        }

        @keyframes slideOut {
            from {
                transform: translateX(0);
                opacity: 1;
            }
            to {
                transform: translateX(400px);
                opacity: 0;
            }
        }
    `;
    document.head.appendChild(style);
</script>
