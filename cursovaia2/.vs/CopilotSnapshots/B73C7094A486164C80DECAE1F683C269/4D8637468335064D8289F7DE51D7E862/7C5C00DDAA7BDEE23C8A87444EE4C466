@using cursovaia2.ModelsDb;
@model OrderDb

@{
	ViewData["Title"] = "Заказ подтвержден";
}

<div class="container mt-5">
	<div class="row justify-content-center">
		<div class="col-md-6">
			<div class="card border-success">
				<div class="card-body text-center">
					<div style="font-size: 48px; margin-bottom: 20px;">✅</div>
					<h2 class="text-success">Заказ успешно оформлен!</h2>
					<hr>

					<div class="alert alert-success">
						<p class="mb-0">
							<strong>Номер заказа:</strong><br>
							<span style="font-size: 20px; font-weight: bold;">#@Model.Id</span>
						</p>
					</div>

					<div class="mb-3">
						<p><strong>Дата:</strong> @Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</p>
						<p><strong>Статус:</strong> <span class="badge bg-warning">@Model.Status</span></p>
						<p><strong>Сумма:</strong> <span style="font-size: 18px; color: #28a745;">@Model.FinalPrice.ToString("C")</span></p>
					</div>

					<div class="mb-4 text-start">
						<h5>📦 Товары в заказе:</h5>
						<div style="max-height: 200px; overflow-y: auto;">
							@if (Model.Items != null && Model.Items.Any())
							{
								<table class="table table-sm">
									<tbody>
										@foreach (var item in Model.Items)
										{
											<tr>
												<td>@item.Product?.Name</td>
												<td class="text-end">@item.Quantity шт.</td>
												<td class="text-end fw-bold">@(item.Price * item.Quantity).ToString("C")</td>
											</tr>
										}
									</tbody>
								</table>
							}
						</div>
					</div>

					<div class="mb-4 p-3 bg-light rounded">
						<h5>📍 Адрес доставки:</h5>
						<p class="mb-0">
							@Model.ShippingAddress<br>
							@Model.ShippingCity, @Model.ShippingPostalCode<br>
							📱 @Model.ShippingPhone
						</p>
					</div>

					<div class="alert alert-info">
						<small>
							Спасибо за покупку! Вскоре вы получите письмо с деталями доставки на почту.
						</small>
					</div>

					<div class="d-flex gap-2">
						<a href="/Checkout/Orders" class="btn btn-primary flex-grow-1">
							📋 Мои заказы
						</a>
						<a href="/Product/Catalog" class="btn btn-outline-primary flex-grow-1">
							🛍️ Продолжить покупки
						</a>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
