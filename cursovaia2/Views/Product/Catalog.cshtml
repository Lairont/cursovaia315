@using cursovaia2.Models
@model CatalogViewModel

@{
    ViewData["Title"] = "Каталог товаров";
}

<div class="catalog-page">
    <header class="catalog-page__header">
        <h1>Каталог товаров</h1>
        <p class="catalog-page__subtitle">Найдите товары, которые вам нравятся</p>
    </header>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <div class="catalog-layout">
        <aside class="catalog-sidebar">
            <form method="get" action="/Product/Catalog" class="search-bar">
                <input type="text" name="searchQuery" placeholder="Поиск товаров..." value="@Model.SearchQuery">
                <button type="submit" class="btn btn-primary">Найти</button>
            </form>

            <div class="filter-section">
                <div class="filter-card">
                    <div class="filter-card__header">Категории</div>
                    <div class="filter-list">
                        <a href="/Product/Catalog" class="filter-list__item @(Model.SelectedCategoryId == null ? "filter-list__item--active" : "")">Все категории</a>
                        @foreach (var category in Model.Categories)
                        {
                            <a href="/Product/Catalog?categoryId=@category.Id"
                               class="filter-list__item @(Model.SelectedCategoryId == category.Id ? "filter-list__item--active" : "")">
                                @category.Name
                            </a>
                        }
                    </div>
                </div>
            </div>

            <div class="filter-section">
                <div class="filter-card">
                    <div class="filter-card__header">Бренды</div>
                    <div class="filter-list">
                        <a href="/Product/Catalog" class="filter-list__item @(Model.SelectedBrandId == null ? "filter-list__item--active" : "")">Все бренды</a>
                        @foreach (var brand in Model.Brands)
                        {
                            <a href="/Product/Catalog?brandId=@brand.Id"
                               class="filter-list__item @(Model.SelectedBrandId == brand.Id ? "filter-list__item--active" : "")">
                                @brand.Name
                            </a>
                        }
                    </div>
                </div>
            </div>

            <div class="filter-section">
                <div class="filter-card">
                    <div class="filter-card__header">Цена</div>
                    <form method="get" action="/Product/Catalog" class="price-filter">
                        <label>От:</label>
                        <input type="number" name="minPrice" placeholder="Мин." step="0.01" value="@Model.MinPrice">
                        <label>До:</label>
                        <input type="number" name="maxPrice" placeholder="Макс." step="0.01" value="@Model.MaxPrice">
                        <button type="submit" class="btn btn-primary btn-sm">Применить</button>
                    </form>
                </div>
            </div>

            <div class="filter-section">
                <div class="filter-card">
                    <div class="filter-card__header">Сортировка</div>
                    <form method="get" action="/Product/Catalog">
                        <select name="sortBy" class="form-select" onchange="this.form.submit()">
                            <option value="">По умолчанию</option>
                            <option value="name_asc" selected="@(Model.SortBy == "name_asc")">По названию (А-Я)</option>
                            <option value="name_desc" selected="@(Model.SortBy == "name_desc")">По названию (Я-А)</option>
                            <option value="price_asc" selected="@(Model.SortBy == "price_asc")">По цене ↑</option>
                            <option value="price_desc" selected="@(Model.SortBy == "price_desc")">По цене ↓</option>
                        </select>
                    </form>
                </div>
            </div>
        </aside>

        <section class="catalog-products">
            @if (Model.Products.Any())
            {
                <div class="products-grid">
                    @foreach (var product in Model.Products)
                    {
                        var rating = Model.ProductRatings.GetValueOrDefault(product.Id, new RatingSummary());
                        var price = Model.ProductPrices.GetValueOrDefault(product.Id, new ProductPriceInfo { OriginalPrice = product.Price, FinalPrice = product.Price });
                        var inWishlist = Model.WishlistProductIds.Contains(product.Id);
                        <article class="product-card">
                            <div class="product-card__image-wrap">
                                <a href="/Product/Detail/@product.Id" class="product-card__image">
                                    @{ ViewData["CssClass"] = "product-card__img"; }
                                    @await Html.PartialAsync("_ProductThumbnail", product)
                                </a>
                                @{ ViewData["ProductId"] = product.Id; ViewData["InWishlist"] = inWishlist; }
                                @await Html.PartialAsync("_WishlistButton")
                            </div>
                            <div class="product-card__body">
                                <h3 class="product-card__title">
                                    <a href="/Product/Detail/@product.Id">@product.Name</a>
                                </h3>
                                <p class="product-card__desc">
                                    @(product.Description?.Length > 60 ? product.Description[..60] + "…" : product.Description)
                                </p>
                                @if (product.Category != null || product.Brand != null)
                                {
                                    <p class="product-card__meta">
                                        @if (product.Category != null) { <span>@product.Category.Name</span> }
                                        @if (product.Brand != null) { <span>@product.Brand.Name</span> }
                                    </p>
                                }
                                <div class="product-card__rating">
                                    @{
                                        ViewData["ProductId"] = product.Id;
                                        ViewData["Average"] = rating.Average;
                                        ViewData["Count"] = rating.Count;
                                        ViewData["UserRating"] = null;
                                        ViewData["Interactive"] = false;
                                        ViewData["Size"] = "sm";
                                    }
                                    @await Html.PartialAsync("_StarRating")
                                </div>
                                <div class="product-card__footer">
                                    @await Html.PartialAsync("_ProductPrice", price)
                                    <span class="product-badge">В наличии</span>
                                </div>
                                <div class="product-card__actions">
                                    <a href="/Product/Detail/@product.Id" class="btn btn-secondary btn-sm">Подробнее</a>
                                    <button type="button" class="btn btn-success btn-sm" onclick="addToCart(@product.Id, 1)">В корзину</button>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <h2>Товары не найдены</h2>
                    <p>Попробуйте изменить параметры фильтрации</p>
                    <a href="/Product/Catalog" class="btn btn-primary">Сбросить фильтры</a>
                </div>
            }
        </section>
    </div>
</div>

<script>
    function addToCart(productId, quantity) {
        fetch('/Cart/AddToCart', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ productId, quantity })
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                showNotification(data.message, 'success');
                updateCartCount(data.cartCount);
            } else {
                showNotification(data.message || 'Ошибка', 'danger');
            }
        })
        .catch(() => showNotification('Ошибка при добавлении в корзину', 'danger'));
    }

    function showNotification(message, type) {
        document.querySelector('.toast-notification')?.remove();
        const toast = document.createElement('div');
        toast.className = `toast-notification alert alert-${type}`;
        toast.textContent = message;
        document.body.appendChild(toast);
        setTimeout(() => toast.remove(), 3000);
    }

    function updateCartCount(count) {
        const el = document.querySelector('[data-cart-count]');
        if (el) el.textContent = count;
    }

    function toggleWishlist(productId, btn) {
        fetch('/Wishlist/Toggle', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ productId })
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                btn.textContent = data.inWishlist ? '♥' : '♡';
                btn.classList.toggle('btn-wishlist--active', data.inWishlist);
                btn.title = data.inWishlist ? 'Убрать из избранного' : 'В избранное';
                showNotification(data.message, 'success');
            } else {
                if (data.message && data.message.includes('Войдите'))
                    window.location.href = '/Account/Login';
                else
                    showNotification(data.message || 'Ошибка', 'danger');
            }
        });
    }
</script>
