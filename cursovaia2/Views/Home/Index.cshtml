@using cursovaia2.Models
@model HomeViewModel

@{
    ViewData["Title"] = "Главная страница";
}

<div class="banner">
    <h1>Добро пожаловать в Stationery Store</h1>
    <p>Ваш магазин канцелярских товаров с огромным выбором и честными ценами</p>
</div>

<div class="home-actions">
    <a href="/Product/Catalog" class="btn btn-primary btn-lg">Перейти в каталог</a>
    @if (Context.Session.GetInt32("UserId") == null)
    {
        <a href="/Account/Register" class="btn btn-register">Создать аккаунт</a>
    }
</div>

@if (Model.PopularProducts.Any())
{
    <h2 class="section-title">Популярные товары</h2>
    <div class="products-grid">
        @foreach (var product in Model.PopularProducts)
        {
            var price = Model.ProductPrices.GetValueOrDefault(product.Id, new ProductPriceInfo { OriginalPrice = product.Price, FinalPrice = product.Price });
            var inWishlist = Model.WishlistProductIds.Contains(product.Id);
            <article class="product-card">
                <div class="product-card__image-wrap">
                    <a href="/Product/Detail/@product.Id" class="product-card__image">
                        @{ ViewData["CssClass"] = "product-card__img"; }
                        @await Html.PartialAsync("_ProductThumbnail", product)
                    </a>
                    @{ ViewData["ProductId"] = product.Id; ViewData["InWishlist"] = inWishlist; }
                    @await Html.PartialAsync("_WishlistButton")
                </div>
                <div class="product-card__body">
                    <h3 class="product-card__title"><a href="/Product/Detail/@product.Id">@product.Name</a></h3>
                    <div class="product-card__footer">
                        @await Html.PartialAsync("_ProductPrice", price)
                    </div>
                    <button type="button" class="btn btn-success btn-sm" onclick="location.href='/Product/Detail/@product.Id'">Смотреть</button>
                </div>
            </article>
        }
    </div>
}

@if (Model.Categories.Any())
{
    <h2 class="section-title">Категории</h2>
    <div class="grid categories">
        <a href="/Product/Catalog" class="category-card">
            <div class="category-icon">📚</div>
            <div class="category-name">Все товары</div>
        </a>
        @foreach (var category in Model.Categories)
        {
            <a href="/Product/Catalog?categoryId=@category.Id" class="category-card">
                <div class="category-icon">📦</div>
                <div class="category-name">@category.Name</div>
            </a>
        }
    </div>
}

<section class="home-features">
    <h2 class="section-title">Почему выбирают нас?</h2>
    <div class="grid">
        <div class="card"><div class="card-body"><div class="feature-icon">✓</div><h5>Низкие цены</h5><p>Конкурентные цены без скрытых комиссий</p></div></div>
        <div class="card"><div class="card-body"><div class="feature-icon">🚚</div><h5>Быстрая доставка</h5><p>Доставляем товары в течение 1–7 дней</p></div></div>
        <div class="card"><div class="card-body"><div class="feature-icon">🔄</div><h5>Гарантия качества</h5><p>Гарантируем качество всех товаров</p></div></div>
        <div class="card"><div class="card-body"><div class="feature-icon">💬</div><h5>Поддержка</h5><p>Поможем с вопросами и заказами</p></div></div>
    </div>
</section>

<section class="home-cta">
    <h2>Начните делать покупки прямо сейчас!</h2>
    <a href="/Product/Catalog" class="btn btn-light btn-lg">Перейти в каталог →</a>
</section>

<script>
function toggleWishlist(productId, btn) {
    fetch('/Wishlist/Toggle', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({productId}) })
    .then(r=>r.json()).then(d=>{
        if(d.success){ btn.textContent=d.inWishlist?'♥':'♡'; btn.classList.toggle('btn-wishlist--active',d.inWishlist); }
        else if(d.message&&d.message.includes('Войдите')) location.href='/Account/Login';
    });
}
</script>
