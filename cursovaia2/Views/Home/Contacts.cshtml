@{
    ViewData["Title"] = "Контакты";
}

<div style="max-width: 800px; margin: 3rem auto;">
    <h1 style="margin-bottom: 2rem; color: #1e293b;">Свяжитесь с нами</h1>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-bottom: 3rem;">
        <div style="background: white; padding: 2rem; border-radius: 12px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);">
            <h3 style="color: #2563eb; margin-bottom: 1rem;">📞 Телефон</h3>
            <p style="font-size: 1.2rem; margin-bottom: 0.5rem;"><strong>+7 (800) 123-45-67</strong></p>
            <p style="color: #666;">Доступно с 09:00 до 21:00 ежедневно</p>
        </div>

        <div style="background: white; padding: 2rem; border-radius: 12px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);">
            <h3 style="color: #2563eb; margin-bottom: 1rem;">✉️ Email</h3>
            <p style="font-size: 1.2rem; margin-bottom: 0.5rem;"><strong>info@stationerystore.ru</strong></p>
            <p style="color: #666;">Ответ в течение 24 часов</p>
        </div>

        <div style="background: white; padding: 2rem; border-radius: 12px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);">
            <h3 style="color: #2563eb; margin-bottom: 1rem;">📍 Адрес</h3>
            <p style="font-size: 1.2rem; margin-bottom: 0.5rem;"><strong>г. Москва</strong></p>
            <p style="color: #666;">ул. Примерная, д. 1, офис 100</p>
        </div>

        <div style="background: white; padding: 2rem; border-radius: 12px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);">
            <h3 style="color: #2563eb; margin-bottom: 1rem;">🕐 Режим работы</h3>
            <p style="margin-bottom: 0.25rem;"><strong>Пн-Пт:</strong> 09:00 - 21:00</p>
            <p style="margin-bottom: 0.25rem;"><strong>Сб:</strong> 10:00 - 20:00</p>
            <p><strong>Вс:</strong> Выходной</p>
        </div>
    </div>

    <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 2rem; border-radius: 12px; text-align: center; margin-bottom: 3rem;">
        <h2 style="margin-bottom: 1rem;">Часто задаваемые вопросы</h2>
        <p style="opacity: 0.9; margin-bottom: 1rem;">Ответы на популярные вопросы вы найдёте в нашем разделе FAQ</p>
        <a href="#" style="display: inline-block; background: white; color: #667eea; padding: 0.75rem 1.5rem; border-radius: 8px; text-decoration: none; font-weight: 600; transition: all 0.3s ease;">
            Перейти к FAQ
        </a>
    </div>

    <div style="background: white; padding: 2rem; border-radius: 12px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1); margin-bottom: 3rem;">
        <h3 style="color: #1e293b; margin-bottom: 1rem;">Мы в социальных сетях</h3>
        <p style="margin-bottom: 1rem; color: #666;">Следите за нашими новостями и акциями:</p>
        <div style="display: flex; gap: 1rem;">
            <a href="#" style="display: inline-flex; align-items: center; justify-content: center; width: 50px; height: 50px; background: #e0e7ff; border-radius: 50%; color: #2563eb; font-size: 1.5rem; transition: all 0.3s ease; text-decoration: none;">
                f
            </a>
            <a href="#" style="display: inline-flex; align-items: center; justify-content: center; width: 50px; height: 50px; background: #e0e7ff; border-radius: 50%; color: #2563eb; font-size: 1.5rem; transition: all 0.3s ease; text-decoration: none;">
                📱
            </a>
            <a href="#" style="display: inline-flex; align-items: center; justify-content: center; width: 50px; height: 50px; background: #e0e7ff; border-radius: 50%; color: #2563eb; font-size: 1.5rem; transition: all 0.3s ease; text-decoration: none;">
                🐦
            </a>
        </div>
    </div>

    <div style="text-align: center;">
        <a href="/" class="btn btn-primary" style="padding: 1rem 2rem; font-size: 1.1rem;">
            На главную
        </a>
    </div>
</div>
