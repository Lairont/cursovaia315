@model List<cursovaia2.ModelsDb.PaymentDb>
@{ ViewData["Title"] = "Платежи"; }
<div class="admin-panel">
    <form method="post" action="/Admin/SavePayment" class="admin-form">
        @Html.AntiForgeryToken()
        <div><label>Заказ</label><select name="orderId" asp-items="ViewBag.Orders" required></select></div>
        <div><label>Сумма</label><input type="number" step="0.01" name="amount" required></div>
        <div><label>Способ</label><select name="methodId" asp-items="ViewBag.Methods"><option value="">—</option></select></div>
        <div><label>Статус</label><select name="status"><option value="pending">pending</option><option value="paid">paid</option><option value="failed">failed</option></select></div>
        <button type="submit" class="btn btn-primary">Добавить</button>
    </form>
</div>
<div class="admin-panel">
    <table class="admin-table">
        <thead><tr><th>ID</th><th>Заказ</th><th>Сумма</th><th>Статус</th><th>Способ</th><th></th></tr></thead>
        <tbody>@foreach (var p in Model) {
            <tr><td>@p.Id</td><td>@p.OrderId</td><td>@p.Amount</td><td>@p.Status</td><td>@(p.Method?.Name)</td>
            <td><form method="post" action="/Admin/DeletePayment">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@p.Id"><button class="btn-admin btn-admin--danger">×</button></form></td></tr>
        }</tbody>
    </table>
</div>
