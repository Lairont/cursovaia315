@model List<cursovaia2.ModelsDb.WishlistDb>
@{ ViewData["Title"] = "Избранное"; }
<div class="admin-panel">
    <table class="admin-table">
        <thead><tr><th>ID</th><th>User</th><th>Товар</th><th>Дата</th><th></th></tr></thead>
        <tbody>@foreach (var w in Model) {
            <tr><td>@w.Id</td><td>@w.CustomerId</td><td>@(w.Product?.Name)</td><td>@w.CreatedAt.ToLocalTime().ToString("g")</td>
            <td><form method="post" action="/Admin/DeleteWishlist">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@w.Id"><button class="btn-admin btn-admin--danger">×</button></form></td></tr>
        }</tbody>
    </table>
</div>
