@using cursovaia2.ModelsDb;
@model List<OrderDb>

@{
	ViewData["Title"] = "Мои заказы";
}

<div class="container mt-4">
	<h1>📋 Мои заказы</h1>
	<hr>

	@if (Model != null && Model.Any())
	{
		<div class="row">
			@foreach (var order in Model)
			{
				<div class="col-md-6 mb-3">
					<div class="card">
						<div class="card-header bg-info text-white">
							<div class="d-flex justify-content-between align-items-center">
								<span><strong>Заказ #@order.Id</strong></span>
								<span class="badge bg-warning">@order.Status</span>
							</div>
						</div>
						<div class="card-body">
							<p class="mb-2">
								<strong>📅 Дата:</strong> @order.CreatedAt.ToString("dd.MM.yyyy HH:mm")
							</p>
							<p class="mb-2">
								<strong>📦 Товаров:</strong> @order.Items?.Sum(x => x.Quantity) шт.
							</p>
							<p class="mb-3">
								<strong>💰 Сумма:</strong> <span style="color: #28a745; font-size: 18px;">@order.FinalPrice.ToString("C")</span>
							</p>

							<div class="mb-3" style="max-height: 100px; overflow-y: auto;">
								@if (order.Items != null && order.Items.Any())
								{
									<small class="text-muted">
										@foreach (var item in order.Items)
										{
											<div>• @item.Product?.Name (@item.Quantity шт.)</div>
										}
									</small>
								}
							</div>

							<p class="mb-0">
								<strong>📍 Доставка:</strong><br>
								<small>Информация о доставке будет обновлена позже</small>
							</p>

							<div class="mt-3">
								<a href="/Checkout/OrderDetails/@order.Id" class="btn btn-sm btn-outline-primary w-100">
									Подробнее →
								</a>
							</div>
						</div>
					</div>
				</div>
			}
		</div>
	}
	else
	{
		<div class="alert alert-info">
			<p class="mb-0">У вас еще нет заказов. <a href="/Product/Catalog">Перейти в каталог →</a></p>
		</div>
	}

	<div class="mt-4">
		<a href="/Product/Catalog" class="btn btn-outline-secondary">
			← Вернуться в каталог
		</a>
	</div>
</div>
