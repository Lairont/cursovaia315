@model List<cursovaia2.ModelsDb.CustomerDb>
@{ ViewData["Title"] = "Покупатели"; }
<div class="admin-panel">
    <table class="admin-table">
        <thead><tr><th>ID</th><th>Имя</th><th>Email</th><th>Телефон</th><th>Бонусы</th><th></th></tr></thead>
        <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Id</td>
                <td colspan="4">
                    <form method="post" action="/Admin/SaveCustomer" class="admin-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@c.Id">
                        <div><input type="text" name="name" value="@c.Name" placeholder="Имя" required></div>
                        <div><span>@(c.User?.Email)</span></div>
                        <div><input type="text" name="phone" value="@c.Phone" placeholder="Телефон"></div>
                        <div><input type="number" step="0.01" name="bonusBalance" value="@c.BonusBalance"></div>
                        <button type="submit" class="btn-admin btn-admin--primary">Сохранить</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
