@using cursovaia2.Models
@model ProductDetailViewModel

@{
    ViewData["Title"] = Model.Product.Name;
    var p = Model.Product;
}

<div class="product-detail">
    <nav class="breadcrumb">
        <a href="/">Главная</a> /
        <a href="/Product/Catalog">Каталог</a> /
        @if (p.Category != null)
        {
            <a href="/Product/Catalog?categoryId=@p.Category.Id">@p.Category.Name</a> @:/
        }
        <span>@p.Name</span>
    </nav>

    <div class="product-detail__main">
        <div class="product-detail__gallery">
            @{
                var mainImage = p.Images?.FirstOrDefault();
            }
            @if (mainImage != null && !string.IsNullOrEmpty(mainImage.Url))
            {
                <img src="@mainImage.Url" alt="@p.Name" class="product-detail__image">
            }
            else
            {
                <div class="product-detail__placeholder">📦</div>
            }
        </div>

        <div class="product-detail__info">
            <h1>@p.Name</h1>

            <div class="product-detail__rating-block">
                @{
                    ViewData["ProductId"] = p.Id;
                    ViewData["Average"] = Model.Rating.Average;
                    ViewData["Count"] = Model.Rating.Count;
                    ViewData["UserRating"] = Model.UserRating;
                    ViewData["Interactive"] = true;
                    ViewData["Size"] = "lg";
                }
                @await Html.PartialAsync("_StarRating")
                @if (Context.Session.GetInt32("UserId") == null)
                {
                    <p class="rating-hint"><a href="/Account/Login">Войдите</a>, чтобы поставить оценку</p>
                }
                else
                {
                    <p class="rating-hint">Нажмите на звезду, чтобы оценить товар</p>
                }
            </div>

            <p class="product-detail__sku">SKU: <strong>@p.Sku</strong></p>

            @if (p.Category != null || p.Brand != null)
            {
                <div class="product-detail__tags">
                    @if (p.Category != null) { <span class="tag tag--info">@p.Category.Name</span> }
                    @if (p.Brand != null) { <span class="tag tag--muted">@p.Brand.Name</span> }
                </div>
            }

            <div class="product-detail__price-box">
                @await Html.PartialAsync("_ProductPrice", Model.Price)
                <span class="product-badge">В наличии</span>
            </div>

            @if (!string.IsNullOrEmpty(p.Description))
            {
                <section class="product-detail__section">
                    <h3>Описание</h3>
                    <p>@p.Description</p>
                </section>
            }

            @if (p.Attributes != null && p.Attributes.Any())
            {
                <section class="product-detail__section">
                    <h3>Характеристики</h3>
                    <table class="attrs-table">
                        @foreach (var attr in p.Attributes.Take(10))
                        {
                            <tr>
                                <th>@attr.Key</th>
                                <td>@attr.Value</td>
                            </tr>
                        }
                    </table>
                </section>
            }

            <div class="product-detail__buy">
                <label for="quantity">Количество:</label>
                <div class="qty-control">
                    <button type="button" onclick="decreaseQuantity()">−</button>
                    <input type="number" id="quantity" value="1" min="1" max="999">
                    <button type="button" onclick="increaseQuantity()">+</button>
                </div>
                @{ ViewData["ProductId"] = p.Id; ViewData["InWishlist"] = Model.InWishlist; }
                <button type="button" class="btn-wishlist btn-wishlist--lg @(Model.InWishlist ? "btn-wishlist--active" : "")" onclick="toggleWishlist(@p.Id, this)" title="Избранное">
                    @(Model.InWishlist ? "♥ В избранном" : "♡ В избранное")
                </button>
                <button type="button" class="btn btn-success btn-lg" onclick="addToCart(@p.Id)">
                    Добавить в корзину
                </button>
            </div>

            <div class="product-detail__links">
                <a href="/Product/Catalog" class="btn btn-secondary">← В каталог</a>
                @if (p.Category != null)
                {
                    <a href="/Product/Catalog?categoryId=@p.Category.Id" class="btn btn-primary">Ещё в категории →</a>
                }
            </div>
        </div>
    </div>

    @if (Model.SimilarProducts.Any())
    {
        <section class="similar-products">
            <h2>Похожие товары</h2>
            <div class="products-grid">
                @foreach (var similar in Model.SimilarProducts)
                {
                    var rating = Model.SimilarRatings.GetValueOrDefault(similar.Id, new RatingSummary());
                    var simPrice = Model.SimilarPrices.GetValueOrDefault(similar.Id, new ProductPriceInfo { OriginalPrice = similar.Price, FinalPrice = similar.Price });
                    var simWish = Model.WishlistProductIds.Contains(similar.Id);
                    <article class="product-card">
                        <div class="product-card__image-wrap">
                            <a href="/Product/Detail/@similar.Id" class="product-card__image">
                                @{ ViewData["CssClass"] = "product-card__img"; }
                                @await Html.PartialAsync("_ProductThumbnail", similar)
                            </a>
                            @{ ViewData["ProductId"] = similar.Id; ViewData["InWishlist"] = simWish; }
                            @await Html.PartialAsync("_WishlistButton")
                        </div>
                        <div class="product-card__body">
                            <h3 class="product-card__title">
                                <a href="/Product/Detail/@similar.Id">@similar.Name</a>
                            </h3>
                            <div class="product-card__rating">
                                @{
                                    ViewData["ProductId"] = similar.Id;
                                    ViewData["Average"] = rating.Average;
                                    ViewData["Count"] = rating.Count;
                                    ViewData["UserRating"] = null;
                                    ViewData["Interactive"] = false;
                                    ViewData["Size"] = "sm";
                                }
                                @await Html.PartialAsync("_StarRating")
                            </div>
                            <div class="product-card__footer">
                                @await Html.PartialAsync("_ProductPrice", simPrice)
                            </div>
                            <button type="button" class="btn btn-success btn-sm" onclick="addToCart(@similar.Id, 1)">В корзину</button>
                        </div>
                    </article>
                }
            </div>
        </section>
    }
</div>

<script>
    const isLoggedIn = @(Context.Session.GetInt32("UserId") != null ? "true" : "false");

    document.querySelectorAll('.star-rating--interactive .star').forEach(star => {
        star.addEventListener('click', function () {
            if (!isLoggedIn) {
                window.location.href = '/Account/Login';
                return;
            }
            const rating = parseInt(this.dataset.value);
            const productId = parseInt(this.closest('.star-rating').dataset.productId);
            submitRating(productId, rating);
        });
    });

    function submitRating(productId, rating) {
        fetch('/Review/SubmitRating', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ productId, rating })
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                updateStarsDisplay(data.average, data.count, data.userRating);
                showNotification('Оценка сохранена', 'success');
            } else {
                showNotification(data.message || 'Ошибка', 'danger');
            }
        })
        .catch(() => showNotification('Ошибка при сохранении оценки', 'danger'));
    }

    function updateStarsDisplay(average, count, userRating) {
        const container = document.querySelector('.star-rating--interactive');
        if (!container) return;
        const stars = container.querySelectorAll('.star');
        stars.forEach((star, idx) => {
            const val = idx + 1;
            star.classList.toggle('star--filled', count > 0 && val <= Math.round(average));
            star.classList.toggle('star--user', val <= userRating);
        });
        const meta = container.querySelector('.star-rating__meta');
        if (count > 0) {
            meta.innerHTML = `<span class="star-rating__avg">${average.toFixed(1)}</span><span class="star-rating__count">(${count})</span>`;
        }
    }

    function increaseQuantity() {
        const input = document.getElementById('quantity');
        input.value = parseInt(input.value) + 1;
    }

    function decreaseQuantity() {
        const input = document.getElementById('quantity');
        if (parseInt(input.value) > 1) input.value = parseInt(input.value) - 1;
    }

    function addToCart(productId) {
        const qty = parseInt(document.getElementById('quantity').value) || 1;
        fetch('/Cart/AddToCart', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ productId, quantity: qty })
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                showNotification(data.message, 'success');
                const el = document.querySelector('[data-cart-count]');
                if (el) el.textContent = data.cartCount;
                document.getElementById('quantity').value = 1;
            } else {
                showNotification(data.message || 'Ошибка', 'danger');
            }
        });
    }

    function toggleWishlist(productId, btn) {
        fetch('/Wishlist/Toggle', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ productId })
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                btn.classList.toggle('btn-wishlist--active', data.inWishlist);
                btn.textContent = data.inWishlist ? '♥ В избранном' : '♡ В избранное';
                showNotification(data.message, 'success');
            } else if (data.message) {
                if (data.message.includes('Войдите')) window.location.href = '/Account/Login';
                else showNotification(data.message, 'danger');
            }
        });
    }

    function showNotification(message, type) {
        document.querySelector('.toast-notification')?.remove();
        const toast = document.createElement('div');
        toast.className = `toast-notification alert alert-${type}`;
        toast.textContent = message;
        document.body.appendChild(toast);
        setTimeout(() => toast.remove(), 3000);
    }
</script>
