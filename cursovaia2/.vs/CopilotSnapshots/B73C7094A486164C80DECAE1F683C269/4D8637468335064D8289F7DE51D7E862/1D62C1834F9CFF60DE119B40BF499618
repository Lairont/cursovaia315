@using cursovaia2.ModelsDb;

@{
	ViewData["Title"] = "Каталог товаров";
}

<div class="container-fluid mt-4">
	<div class="row mb-3">
		<div class="col-12">
			<h1>🛍️ Каталог товаров</h1>
			<p class="text-muted">Выберите интересующий вас товар</p>
		</div>
	</div>

	@if (ViewBag.Error != null)
	{
		<div class="alert alert-danger">@ViewBag.Error</div>
	}

	<div class="row">
		<!-- Боковая панель -->
		<div class="col-lg-2">
			<div class="card sticky-top" style="top: 20px;">
				<div class="card-header bg-primary text-white">
					<h5 class="mb-0">📂 Категории</h5>
				</div>
				<div class="list-group list-group-flush">
					<a href="/Product/Catalog" class="list-group-item list-group-item-action">
						✓ Все товары
					</a>
					@if (Model != null)
					{
						var categories = Model.GetType().GetProperty("Categories")?.GetValue(Model) as List<CategoryDb>;
						if (categories != null && categories.Any())
						{
							@foreach (var category in categories)
							{
								var selectedId = Model.GetType().GetProperty("SelectedCategoryId")?.GetValue(Model) as int?;
								var isActive = selectedId == category.Id;
								<a href="/Product/Catalog?categoryId=@category.Id" 
								   class="list-group-item list-group-item-action @(isActive ? "active bg-primary text-white" : "")">
									@category.Name
								</a>
							}
						}
					}
				</div>
			</div>
		</div>

		<!-- Товары -->
		<div class="col-lg-10">
			<div class="row">
				@if (Model != null)
				{
					var products = Model.GetType().GetProperty("Products")?.GetValue(Model) as List<ProductDb>;

					@if (products != null && products.Any())
					{
						@foreach (var product in products)
						{
							<div class="col-sm-6 col-lg-4 col-xl-3 mb-4">
								<div class="card h-100 product-card" style="transition: all 0.3s ease; cursor: pointer;" onmouseover="this.style.transform='translateY(-5px)'; this.style.boxShadow='0 8px 16px rgba(0,0,0,0.2)'" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='none'">
									<!-- Изображение товара -->
									<div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); height: 180px; display: flex; align-items: center; justify-content: center; color: white; font-size: 48px;">
										📦
									</div>

									<div class="card-body d-flex flex-column">
										<h5 class="card-title" style="font-size: 14px; font-weight: 600; min-height: 40px;">
											@product.Name
										</h5>

										<p class="card-text text-muted" style="font-size: 12px; flex-grow: 1;">
											@(product.Description?.Length > 50 ? product.Description.Substring(0, 50) + "..." : product.Description)
										</p>

										<!-- Цена и статус -->
										<div class="mb-3">
											<div class="d-flex justify-content-between align-items-center mb-2">
												<span class="h4 mb-0 text-primary">
													@product.Price.ToString("C")
												</span>
												<span class="badge bg-success">В наличии</span>
											</div>
											<small class="text-muted">
												SKU: @product.Sku
											</small>
										</div>

										<!-- Кнопки -->
										<div class="btn-group w-100" role="group">
											<a href="/Product/Detail/@product.Id" class="btn btn-sm btn-outline-info flex-grow-1">
												👁️ Подробнее
											</a>
											<button class="btn btn-sm btn-success flex-grow-1" onclick="addToCart(@product.Id, 1)">
												🛒 Добавить
											</button>
										</div>
									</div>
								</div>
							</div>
						}
					}
					else
					{
						<div class="col-12">
							<div class="alert alert-info">
								<p class="mb-0">Товары не найдены в выбранной категории.</p>
							</div>
						</div>
					}
				}
				else
				{
					<div class="col-12">
						<div class="alert alert-warning">
							<p class="mb-0">Ошибка при загрузке каталога.</p>
						</div>
					</div>
				}
			</div>
		</div>
	</div>
</div>

<!-- Стили для товарной карточки -->
<style>
	.product-card {
		border: 1px solid #e0e0e0;
		border-radius: 8px;
	}

	.product-card:hover {
		border-color: #667eea;
	}
</style>

<!-- JavaScript для добавления в корзину -->
<script>
	function addToCart(productId, quantity) {
		fetch('/Cart/AddToCart', {
			method: 'POST',
			headers: {
				'Content-Type': 'application/json',
			},
			body: JSON.stringify({
				productId: productId,
				quantity: quantity
			})
		})
		.then(response => response.json())
		.then(data => {
			if (data.success) {
				// Показываем уведомление
				showNotification('✓ ' + data.message, 'success');

				// Обновляем счётчик корзины
				updateCartCountDisplay(data.cartCount);
			} else {
				showNotification('❌ ' + data.message, 'danger');
			}
		})
		.catch(error => {
			console.error('Error:', error);
			showNotification('❌ Ошибка при добавлении в корзину', 'danger');
		});
	}

	function showNotification(message, type) {
		// Если уже есть уведомление, удаляем его
		const existing = document.querySelector('.toast-notification');
		if (existing) {
			existing.remove();
		}

		const toast = document.createElement('div');
		toast.className = `toast-notification alert alert-${type}`;
		toast.textContent = message;
		toast.style.cssText = `
			position: fixed;
			top: 20px;
			right: 20px;
			min-width: 300px;
			z-index: 9999;
			animation: slideIn 0.3s ease;
		`;

		document.body.appendChild(toast);

		setTimeout(() => {
			toast.style.animation = 'slideOut 0.3s ease';
			setTimeout(() => toast.remove(), 300);
		}, 3000);
	}

	function updateCartCountDisplay(count) {
		const cartCount = document.querySelector('[data-cart-count]');
		if (cartCount) {
			cartCount.textContent = count;
		}
	}

	@* Загружаем начальное количество товаров в корзине *@
	document.addEventListener('DOMContentLoaded', function() {
		fetch('/Cart/GetCartCount')
			.then(response => response.json())
			.then(data => {
				updateCartCountDisplay(data.count);
			});
	});
</script>


