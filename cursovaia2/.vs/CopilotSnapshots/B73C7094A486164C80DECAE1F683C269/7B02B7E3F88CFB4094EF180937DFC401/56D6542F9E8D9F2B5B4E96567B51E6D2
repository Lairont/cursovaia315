using System.ComponentModel.DataAnnotations;
using System.ComponentModel.DataAnnotations.Schema;

namespace cursovaia2.ModelsDb
{
    [Table("users")]
    public class UserDb
    {
        [Key]
        public int Id { get; set; }

        [Column("username")]
        [Required(ErrorMessage = "Имя пользователя требуется")]
        [StringLength(100, MinimumLength = 3, ErrorMessage = "Имя должно быть от 3 до 100 символов")]
        public string Username { get; set; } = string.Empty;

        [Column("email")]
        [Required(ErrorMessage = "Email требуется")]
        [EmailAddress(ErrorMessage = "Некорректный email адрес")]
        public string Email { get; set; } = string.Empty;

        [Column("password_hash")]
        [Required(ErrorMessage = "Пароль требуется")]
        [StringLength(255)]
        public string PasswordHash { get; set; } = string.Empty;

        [Column("created_at")]
        public DateTime CreatedAt { get; set; } = DateTime.UtcNow;
    }
}
